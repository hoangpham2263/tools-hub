# Machine-local state, in one place: workspace/ holds the hub's (version, backups, config) and, in workspace/<tool id>/, each tool's results,
# logs, login and cache. Base data stays versioned.
/workspace/
/apps/*/bridge/node_modules/
/hub/bridge/node_modules/
/worker/.wrangler/
/worker/*/.wrangler/
# Sample photos are downloaded per group from Drive; only the catalog is versioned.
/apps/*/data/source-photos/*/
# Legacy photo cache retained locally in old Git checkouts; never publish these photos.
/data/source-photos/
.DS_Store
