{
  "manifest_version": 3,
  "name": "Tools Hub",
  "version": "0.4.6",
  "description": "Cầu nối local của Tools Hub: nhận việc từ các tool (tạo ảnh, viết chữ), làm trong tab Google Flow, Gemini, ChatGPT đang đăng nhập và trả kết quả về máy.",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "alarms", "debugger"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*", "https://gemini.google.com/*"
  ],
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["content-common.js", "content-chatgpt.js"], "run_at": "document_idle" },
    { "matches": ["https://flow.google.com/*"], "js": ["content-common.js", "content-flow.js"], "run_at": "document_idle" },
    { "matches": ["https://gemini.google.com/*"], "js": ["content-common.js", "content-gemini.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Tools Hub", "default_popup": "popup.html" }
}
